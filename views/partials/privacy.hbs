<section class="section privacy-section" id="privacy" aria-labelledby="privacy-heading">
  <div class="wrap">
    <div class="privacy-section__frame">
      <img class="privacy-section__mark" src="{{nav.logoSrc}}" alt="" aria-hidden="true" />
      <span class="eyebrow privacy-section__eyebrow">{{privacy.eyebrow}}</span>
      <h2 id="privacy-heading" class="privacy-section__heading heading-2">{{privacy.heading}}</h2>
      <p class="privacy-section__body body-text--lg">{{privacy.body}}</p>
    </div>
  </div>
</section>
