<section class="section section--light" id="aranya" aria-labelledby="aranya-heading">
  <div class="wrap aranya">
    <div
      class="aranya__media"
      data-aranya-media
    >
      <!-- Desktop single art panel (active photograph with crossfade) -->
      <div
        class="art-panel art-panel--tall aranya__desktop-panel"
        data-aranya-image
      >
        <div class="topo-field topo-field--photo">
          <img
            class="media-fill"
            src="{{aranya.image.src}}"
            alt="{{aranya.image.alt}}"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="art-panel__frame"></div>
        <div class="art-panel__caption">
          <span class="art-panel__caption-text" data-aranya-caption>{{aranya.panelCaption}}</span>
        </div>
      </div>

      <!-- Mobile slider (visible on mobile view only) -->
      <div class="aranya__slider" data-aranya-slider>
        <div class="aranya__slider-viewport" data-aranya-viewport data-lenis-prevent-horizontal>
          <div class="aranya__slider-track">
            {{#each aranya.slides}}
              <div class="aranya-slide art-panel art-panel--tall" data-slide-index="{{@index}}">
                <div class="topo-field topo-field--photo">
                  <img
                    class="media-fill"
                    src="{{this.image.src}}"
                    alt="{{this.image.alt}}"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="art-panel__frame"></div>
                <div class="art-panel__caption">
                  <span class="art-panel__caption-text">{{this.caption}}</span>
                  <span class="aranya-slide__count" aria-hidden="true">{{this.index}}</span>
                </div>
              </div>
            {{/each}}
          </div>
        </div>

        <div class="aranya__slider-controls">
          <button
            class="aranya__slider-btn"
            type="button"
            data-aranya-prev
            aria-label="Previous slide"
          ></button>
          <button
            class="aranya__slider-btn"
            type="button"
            data-aranya-next
            aria-label="Next slide"
          ></button>
        </div>
      </div>
    </div>

    <div class="aranya__copy">
      <div class="aranya__intro">
        <span class="eyebrow">{{aranya.eyebrow}}</span>
        <h2 id="aranya-heading" class="heading-2">{{aranya.heading}}</h2>
        <div class="aranya__body">
          <p class="heading-sub">{{aranya.subheading}}</p>
          <p class="body-text body-text--lg">{{aranya.body}}</p>
        </div>
      </div>

      <div class="aranya__aside">
        <div class="feature-tags">
          {{#each aranya.features}}
            <button
              type="button"
              class="feature-tags__item"
              data-image="{{this.image.src}}"
              data-alt="{{this.image.alt}}"
              data-caption="{{this.caption}}"
              data-slide="{{@index}}"
              aria-pressed="false"
            >{{this.label}}</button>
          {{/each}}
        </div>
        <a class="text-link" href="{{aranya.cta.href}}">
          {{aranya.cta.label}}
          <svg class="btn__icon" viewBox="0 0 13 9" fill="none" aria-hidden="true">
            <path d="M0 4.5H12M12 4.5L8 0.5M12 4.5L8 8.5" stroke="currentColor" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
