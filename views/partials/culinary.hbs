<section class="section section--light" id="culinary" aria-labelledby="culinary-heading">
  <div class="culinary">
    <figure class="culinary__media reveal">
      <img
        src="{{culinary.image.src}}"
        alt="{{culinary.image.alt}}"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="culinary__copy">
      <span class="eyebrow">{{culinary.eyebrow}}</span>
      <h2 id="culinary-heading" class="section-intro__heading heading-2">{{culinary.heading}}</h2>
      <p class="heading-sub">{{culinary.subheading}}</p>
      <div class="home-copy">
        <p class="body-text body-text--lg">{{culinary.body}}</p>
      </div>

      <ul class="culinary-themes">
        {{#each culinary.themes}}
          <li class="culinary-themes__item">
            <span class="culinary-themes__label">{{this}}</span>
          </li>
        {{/each}}
      </ul>

      <a class="text-link culinary__cta" href="{{culinary.cta.href}}">
        {{culinary.cta.label}}
        <svg class="btn__icon" viewBox="0 0 13 9" fill="none" aria-hidden="true">
          <path d="M0 4.5H12M12 4.5L8 0.5M12 4.5L8 8.5" stroke="currentColor" />
        </svg>
      </a>
    </div>
  </div>
</section>
