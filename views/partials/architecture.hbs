<section
  class="section section--light architecture"
  id="architecture"
  aria-labelledby="architecture-heading"
>
  <h2 id="architecture-heading" class="sr-only">{{architecture.heading}}</h2>

  <div class="architecture__stage" data-architecture-stage>
    <div class="architecture__pin">
      <div class="architecture__white-panel" aria-hidden="true">
        <div class="architecture__sheet"></div>
      </div>

      {{! Copy is a sibling of the translating sheet — Safari collapses
          multi-line text inside ancestors that use transform. }}
      <div class="architecture__copy" data-architecture-copy aria-hidden="true">
        <div class="architecture__body">
          <p class="statement">{{architecture.statement}}</p>
          <p class="body-text">{{architecture.body}}</p>
        </div>
      </div>

      <div class="architecture__slides" data-architecture-slides aria-hidden="true">
        <div class="architecture__backdrop" data-architecture-backdrop aria-hidden="true">
          <img
            class="media-fill"
            data-architecture-backdrop-img
            src="{{architecture.image.src}}"
            alt=""
          />
        </div>
        <div class="architecture__slides-track" data-architecture-slides-track>
          {{#each architecture.materials}}
            <div
              class="architecture__slide"
              data-caption="{{this.caption}}"
              data-tag="{{this.tag}}"
              data-image="{{this.image.src}}"
            >
              <img
                class="media-fill"
                src="{{this.image.src}}"
                alt="{{this.image.alt}}"
                loading="lazy"
                decoding="async"
              />
              <div class="architecture__slide-material" aria-hidden="true">
                <span class="architecture__slide-label">{{this.label}}</span>
              </div>
            </div>
          {{/each}}
        </div>
        <div class="architecture__scrim" data-architecture-scrim aria-hidden="true"></div>
      </div>

      <div class="architecture__intro-frame" data-architecture-intro-frame>
        <div class="architecture__intro-scale">
          <span class="eyebrow eyebrow--center">{{architecture.eyebrow}}</span>
          <p class="architecture__intro-display heading-display" aria-hidden="true">
            {{#each architecture.introHeadingLines}}{{this}}{{#unless @last}}<br />{{/unless}}{{/each}}
          </p>
        </div>
      </div>

      <div class="architecture__caption" data-architecture-caption-wrap>
        <span class="architecture__caption-text" data-architecture-caption>{{architecture.panelCaption}}</span>
        <span class="architecture__caption-tag" data-architecture-tag>{{architecture.panelTag}}</span>
      </div>

    </div>
  </div>

  <div class="architecture__static">
    <div class="architecture__intro">
      <span class="eyebrow">{{architecture.eyebrow}}</span>
      <h2 class="heading-2">{{architecture.heading}}</h2>
    </div>

    <div class="architecture__static-cards" data-architecture-static-cards>
      {{#each architecture.materials}}
        <article class="architecture__static-card">
          <img
            class="media-fill"
            src="{{this.image.src}}"
            alt="{{this.image.alt}}"
            loading="lazy"
            decoding="async"
          />
          <div class="architecture__static-card-scrim" aria-hidden="true"></div>
          <span class="architecture__slide-label">{{this.label}}</span>
        </article>
      {{/each}}
    </div>

    <div class="architecture__static-copy">
      <p class="statement">{{architecture.statement}}</p>
      <p class="body-text">{{architecture.body}}</p>
    </div>
  </div>
</section>
