<section class="section section--deep" id="architecture" aria-labelledby="architecture-heading">
  <div class="wrap split split--40-60">
    <div class="order-2-mobile">
      <span class="eyebrow">{{architecture.eyebrow}}</span>
      <h2 id="architecture-heading" class="section-intro__heading heading-2">{{architecture.heading}}</h2>
      <div class="home-copy">
        <p class="statement">{{architecture.statement}}</p>
        <p class="body-text">{{architecture.body}}</p>
      </div>
      <div class="material-row">
        {{#each architecture.materials}}
          <div class="material-row__item">
            <span class="material-row__swatch material-row__swatch--{{this.key}}"></span>
            <span class="material-row__label">{{this.label}}</span>
          </div>
        {{/each}}
      </div>
    </div>

    <div class="art-panel art-panel--wide reveal">
      <div class="topo-field topo-field--photo">
        <img
          class="media-fill"
          src="{{architecture.image.src}}"
          alt="{{architecture.image.alt}}"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="art-panel__frame"></div>
      <div class="art-panel__caption">
        <span class="art-panel__caption-text">{{architecture.panelCaption}}</span>
        <span class="art-panel__caption-tag">{{architecture.panelTag}}</span>
      </div>
    </div>
  </div>
</section>
