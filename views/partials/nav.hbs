<header class="site-header" id="siteHeader">
  <div class="site-header__start">
    <nav class="primary-nav" aria-label="Primary">
      {{#each nav.links}}
        <a class="primary-nav__link" href="{{this.href}}">{{this.label}}</a>
      {{/each}}
    </nav>

    <button
      class="menu-toggle"
      id="menuToggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobileMenu"
      aria-label="{{nav.menuLabel}}"
      data-open-label="{{nav.menuLabel}}"
      data-close-label="{{nav.closeLabel}}"
    >
      <span class="menu-toggle__icon" aria-hidden="true">
        <span class="menu-toggle__line"></span>
        <span class="menu-toggle__line"></span>
      </span>
      <span class="menu-toggle__label">{{nav.menuLabel}}</span>
    </button>
  </div>

  <a class="site-header__logo" href="#top" data-header-logo>
    <img
      class="site-header__logo-icon"
      src="{{nav.logoIconSrc}}"
      alt="{{nav.logoName}}"
      width="40"
      height="40"
    />
  </a>

  <div class="site-header__actions">
    <a class="btn btn--accent btn--small" href="{{nav.cta.href}}">{{nav.cta.label}}</a>
  </div>
</header>
